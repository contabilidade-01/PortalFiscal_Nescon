# =============================================================================
# Portal Fiscal Nescon — variáveis de ambiente (EasyPanel / Docker / local)
# Copie para .env (NUNCA commitar) ou cole no EasyPanel → Environment.
# Gerar chaves:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- obrigatórias em produção ---
# Cookie/sessão Flask. Sem isso o EasyPanel usa o fallback inseguro do código.
SECRET_KEY=

# Senha do usuário admin no PRIMEIRO boot (quando o banco ainda está vazio).
# Depois do 1º login, troque em /trocar-senha. Não altera admin já existente.
ADMIN_SENHA_INICIAL=

# 1 = cookie Secure + ProxyFix (atrás do HTTPS do EasyPanel). Local Windows: omitir.
FLASK_HTTPS=1
TRUST_PROXY=1

# --- caminhos no container (já são o default da imagem) ---
FISCAL_DATA_DIR=/app/data
FISCAL_XML_DIR=/app/data/XML
TZ=America/Sao_Paulo

# --- robô diário (puxa NF-e / NFS-e / NFC-e + ciência) ---
# 1 = a thread do worker enfileira job "completo" 1x/dia. Local Windows: 0
#     (aí vale a Tarefa Agendada / start.bat).
FISCAL_CRON=1
FISCAL_CRON_HORA=06:00

# --- opcional / futuro ---
# Criptografia da senha do certificado no banco (Etapa 4b, ainda não ligada).
# CERT_KEY=

# Porta só no `python app.py` local (Docker/waitress usa 8000 no container).
# Não precisa no EasyPanel — o painel mapeia a 8000.
# PORTA=5001

# --- recuperação de senha (mesmo padrão do nescon-clientes) ---
# Sem SMTP, o link "Esqueci minha senha" avisa e o admin redefine em Usuários.
# SMTP_HOST=smtp.seudominio.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Portal Fiscal Nescon <noreply@seudominio.com>"
# URL pública do app (link no e-mail). Ex.: https://fiscal.gestaoempresa.com
# PUBLIC_APP_URL=
# --- anti-ban SEFAZ (controlador + cadência) ---
# 1 = SefazGuard ligado (cooldown, limite horário, circuito). 0 = só cooldown legado.
# SEFAZ_GUARD_ATIVO=1
# SEFAZ_CIRCUITO_LIMIAR=5
#
# Papel do run_diario.py — evita dois processos NFC-e no mesmo IP (G4):
#   web  = só enfileira (EasyPanel: o worker do app processa). Default se FISCAL_CRON=1.
#   cron = enfileira e processa (Tarefa Agendada Windows, app desligado).
# FISCAL_ROLE=web
#
# Ambiente dos webservices SEFAZ: 1=Produção (default) | 2=Homologação.
# Em produção NÃO precisa definir (o default já é 1). 2 é só para testes de
# protocolo (obs.: os endpoints continuam de produção; homologação plena exigiria
# trocar também as URLs — fora do escopo hoje).
# FISCAL_TPAMB=1

# --- alerta anti-ban por WhatsApp (uazapi) — mesmo padrão do nescon-clientes ---
# Dispara SÓ quando o circuito ABRE (serviço parado após N bloqueios seguidos),
# para o responsável rearmar na tela "Saúde SEFAZ". Sem estas duas, o alerta
# fica silencioso (só grava log) e nada quebra.
# Pegue no painel https://free.uazapi.com (a instância precisa estar CONECTADA).
UAZAPI_SUBDOMAIN=
UAZAPI_TOKEN=
# Número que recebe o alerta (só dígitos, DDD+número). Default no código: 11984630568.
SEFAZ_ALERTA_WHATSAPP=11984630568

